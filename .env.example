# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Channel to post to, e.g. @zrojobs (add the bot as channel admin)
TELEGRAM_CHANNEL=
# Google AI Studio key (free tier is enough)
GEMINI_API_KEY=
# Optional overrides
GEMINI_MODEL=gemini-2.5-flash
CHANNEL_HANDLE=
# Shown in the footer as the contact for paid featured listings, e.g. @yourusername
PROMO_CONTACT=
# How many jobs per digest (Gemini picks within this range)
DIGEST_MIN=5
DIGEST_MAX=10
