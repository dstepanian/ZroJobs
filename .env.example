# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Channel to post to, e.g. @zrojobs (add the bot as channel admin)
TELEGRAM_CHANNEL=
# Google AI Studio key (free tier is enough)
GEMINI_API_KEY=
# Optional overrides
GEMINI_MODEL=gemini-2.5-flash
CHANNEL_HANDLE=
# Shown on featured posts as the contact for paid listings, e.g. @yourusername
PROMO_CONTACT=
# Handle employers write to submit a vacancy (intro post). Defaults to PROMO_CONTACT
CONTACT_HANDLE=
# How many jobs per run (Gemini picks within this range) — one post each
DIGEST_MIN=5
DIGEST_MAX=10
# Gap in ms between the individual posts of one run
POST_DELAY_MS=3000
# Reserve this many slots for eligible international/remote jobs.
INTERNATIONAL_MIN=2
INTERNATIONAL_MAX=4
